/* ===== Interface ===== */
const $ = id => document.getElementById(id);
const elStatus = $("status");
const items = [...document.querySelectorAll("#steps li")];
const CIRC = 326.73;
let stepAtual = 0;
let arqUrl = null, arqNome = "";

function setStatus(t, erro){ elStatus.textContent = t; elStatus.className = erro ? "erro" : ""; }
function setRing(p){
  p = Math.max(0, Math.min(1, p));
  $("ringBar").style.strokeDashoffset = CIRC * (1 - p);
  $("pct").textContent = Math.round(p * 100) + "%";
}
function setDetail(i, t){ items[i].querySelector(".det").textContent = t; }
function setStep(i){
  stepAtual = i;
  items.forEach((li, idx) => { li.className = idx < i ? "done" : idx === i ? "active" : "pending"; });
}
function mostrarAcao(label, fn){
  $("btnAcao").textContent = label;
  $("btnAcao").onclick = fn;
  $("actions").classList.add("show");
}
function falhar(msg, permitirRetry){
  if (items[stepAtual]) items[stepAtual].className = "erro";
  $("ring").classList.add("erro");
  $("titulo").textContent = "Não foi possível concluir";
  setStatus(msg, true);
  if (permitirRetry !== false) mostrarAcao("Tentar novamente", () => location.reload());
}

/* ===== Diagnóstico: mostra erros na tela ===== */
window.addEventListener("error", e => falhar(e.message));
window.addEventListener("unhandledrejection", e => falhar((e.reason && e.reason.message) || String(e.reason)));
if (typeof msal === "undefined"){
  falhar("A biblioteca MSAL não carregou (rede ou bloqueador). Teste em janela anônima ou outra rede.");
  throw new Error("MSAL não carregou");
}

/* ===== Autenticação ===== */
const scopes = [CONFIG.site + "/AllSites.Write"];
const msalApp = new msal.PublicClientApplication({
  auth: {
