    --brand:#1F5EFF; --ok:#0F8A5F; --err:#C62F3E; --track:#E6EBF2;
  }
  @media (prefers-color-scheme: dark){
    :root{ --bg:#070D16; --surface:#101A29; --text:#E8EEF7; --muted:#93A3B8; --line:#22324A; --track:#1B2A40; --brand:#4C84FF; --ok:#2FB886; --err:#F0606E; }
