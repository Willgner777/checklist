    authority: "https://login.microsoftonline.com/" + CONFIG.tenantId,
    redirectUri: window.location.origin + window.location.pathname
  },
  cache: { cacheLocation: "localStorage" }
});

async function getToken(){
  const r = await msalApp.handleRedirectPromise();
  const account = (r && r.account) || msalApp.getAllAccounts()[0];
  if (!account){ await msalApp.loginRedirect({ scopes }); return null; }
  try {
    const t = await msalApp.acquireTokenSilent({ scopes, account });
    return t.accessToken;
  } catch (e) {
    await msalApp.acquireTokenRedirect({ scopes, account });
    return null;
  }
}

/* ===== SharePoint REST ===== */
async function sp(url, token, blob){
  const resp = await fetch(url, { headers: {
    Authorization: "Bearer " + token,
    Accept: "application/json;odata=nometadata"
  }});
  if (resp.status === 404){ const e = new Error("NAO_ENCONTRADO"); e.codigo = 404; throw e; }
  if (!resp.ok) throw new Error("SharePoint " + resp.status + " ao acessar " + url);
  return blob ? resp.blob() : resp.json();
}

/* ===== Utilitários de formatação (mesma lógica do fluxo) ===== */
function esc(s){
  return String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
}
function texto(v){
  if (v === null || v === undefined || v === "") return "—";
  if (Array.isArray(v)) return v.length ? v.map(texto).join(", ") : "—";
  if (typeof v === "object") return texto(v.Value ?? v.Title ?? v.Label ?? v.DisplayName ?? "—");
  return String(v);
}
function fmtData(d, comHora){
  const p = Object.fromEntries(new Intl.DateTimeFormat("pt-BR", {
    timeZone: CONFIG.fusoHorario, day: "2-digit", month: "2-digit", year: "numeric",
    hour: "2-digit", minute: "2-digit", second: "2-digit", hourCycle: "h23"
  }).formatToParts(d).map(x => [x.type, x.value]));
  return comHora === "arquivo"
    ? p.year + "-" + p.month + "-" + p.day + " " + p.hour + "-" + p.minute + "-" + p.second
    : p.day + "/" + p.month + "/" + p.year + " " + p.hour + ":" + p.minute;
}

/* Reduz a foto para não gerar um arquivo gigante (miniatura no relatório é 190x140) */
function blobParaDataUrl(blob){
  return new Promise((res, rej) => {
    const r = new FileReader();
    r.onload = () => res(r.result);
    r.onerror = () => rej(new Error("Falha ao ler a foto"));
    r.readAsDataURL(blob);
  });
}
async function fotoParaDataUrl(blob){
  try {
    const url = URL.createObjectURL(blob);
    const img = await new Promise((res, rej) => {
      const im = new Image(); im.onload = () => res(im); im.onerror = rej; im.src = url;
    });
    URL.revokeObjectURL(url);
    const k = Math.min(1, CONFIG.fotoMaxPx / Math.max(img.naturalWidth, img.naturalHeight));
    const c = document.createElement("canvas");
    c.width = Math.round(img.naturalWidth * k); c.height = Math.round(img.naturalHeight * k);
    const ctx = c.getContext("2d");
    ctx.fillStyle = "#fff"; ctx.fillRect(0, 0, c.width, c.height);
    ctx.drawImage(img, 0, 0, c.width, c.height);
    return c.toDataURL("image/jpeg", CONFIG.fotoQualidade);
  } catch (e) {
    return blobParaDataUrl(blob);   /* formato que o navegador não decodifica: usa o original */
  }
}

/* ===== Monta o relatório (mesmo layout do fluxo "GERAR PDF OS") ===== */
function montarRelatorio(item, fotos){
  const id = item.ID ?? item.Id;
  const aval = PERGUNTAS.map(p => {
    const v = item[p.campo] === true;
    return { n: p.n, pergunta: p.pergunta, resposta: v ? "Sim" : "Não", conforme: p.invertido ? !v : v };
  });
  const pend = aval.filter(a => !a.conforme);

  const cab = {
    id: id,
    placa: esc(texto(item[COLUNAS.placa])),
    motorista: esc(texto(item[COLUNAS.motorista])),
    kmSaida: esc(texto(item[COLUNAS.kmSaida])),
    horimetro: esc(texto(item[COLUNAS.horimetro])),
    dataChecklist: item[COLUNAS.criadoEm] ? fmtData(new Date(item[COLUNAS.criadoEm])) : "—",
    emitidoEm: fmtData(new Date()),
    tablet: esc(texto(item[COLUNAS.tablet]))
  };

  const linhas = aval.map(a =>
    '<tr' + (a.conforme ? "" : ' class="is-bad"') + '><td class="num">' + a.n + '</td><td>' + esc(a.pergunta) +
    '</td><td class="st"><span class="badge ' + (a.conforme ? "ok" : "bad") + '">' +
    (a.conforme ? "&#10003; " : "&#10007; ") + a.resposta + '</span></td></tr>'
  ).join("");

  const banner = pend.length === 0
    ? '<div class="banner ok"><strong>Checklist conforme</strong>Todos os ' + aval.length + ' itens foram verificados sem pendências.</div>'
    : '<div class="banner bad"><strong>' + pend.length + (pend.length === 1 ? " item com pendência" : " itens com pendência") +
      ' (de ' + aval.length + ' verificados)</strong><ul>' +
      pend.map(a => '<li><strong>' + a.n + '.</strong> ' + esc(a.pergunta) + ' &mdash; ' + a.resposta + '</li>').join("") +
      '</ul></div>';

  const htmlFotos = fotos.map(src => '<div class="photo-thumb"><img src="' + src + '" alt="Foto" /></div>').join("");

  return '<!doctype html>\n<html lang="pt-BR">\n<head>\n<meta charset="utf-8" />\n' +
  '<meta name="viewport" content="width=device-width,initial-scale=1" />\n' +
  '<title>Checklist Nº ' + cab.id + ' - ' + cab.placa + '</title>\n<style>' + CSS_RELATORIO + '</style>\n</head>\n<body>\n' +
  '  <div class="toolbar"><button type="button" onclick="window.print()">Imprimir / Salvar como PDF</button></div>\n' +
  '  <div class="wrap">\n    <table class="header" role="presentation">\n      <tr>\n' +
  '        <td><img src="data:image/png;base64,' + LOGO_B64 + '" alt="Logo" /></td>\n' +
  '        <td class="title">\n          <h1>CHECKLIST</h1>\n          <span class="numero">N&ordm;&nbsp;' + cab.id + '</span>\n        </td>\n' +
  '      </tr>\n    </table>\n    <div class="accent"></div>\n\n    <div class="container">\n' +
  '      <div class="card">\n        <div class="section-title">Dados Gerais</div>\n        <table class="meta" role="presentation">\n          <tr>\n' +
  '            <td><span class="label">Placa</span><span class="value">' + cab.placa + '</span></td>\n' +
  '            <td><span class="label">Motorista</span><span class="value">' + cab.motorista + '</span></td>\n' +
  '            <td><span class="label">Km Saída</span><span class="value">' + cab.kmSaida + '</span></td>\n' +
  '            <td><span class="label">Horímetro</span><span class="value">' + cab.horimetro + '</span></td>\n          </tr>\n          <tr>\n' +
  '            <td colspan="2"><span class="label">Data do Checklist</span><span class="value">' + cab.dataChecklist + '</span></td>\n' +
  '            <td colspan="2"><span class="label">Relatório emitido em</span><span class="value">' + cab.emitidoEm + '</span></td>\n          </tr>\n        </table>\n' +
  '        <div class="tablet">\n          <span class="label">Condição do tablet / celular</span>\n          <span class="value">' + cab.tablet + '</span>\n        </div>\n      </div>\n\n' +
  '      <div class="card flow">\n        <div class="section-title">Itens Verificados</div>\n        ' + banner + '\n' +
  '        <table class="checklist">\n          <thead><tr><th>#</th><th>Item</th><th>Resposta</th></tr></thead>\n          <tbody>\n            ' + linhas + '\n          </tbody>\n        </table>\n      </div>\n\n' +
  '      <div class="card">\n        <div class="section-title">Evidências Fotográficas</div>\n        ' +
  (htmlFotos ? '<div class="photos">' + htmlFotos + '</div>' : '<p class="empty">Nenhuma foto anexada a este checklist.</p>') + '\n      </div>\n    </div>\n\n' +
  '    <div class="footer">\n      <strong>Rua João Frederico Foerster, 132</strong> · Pinheirinho · Curitiba/PR<br />\n' +
  '      Contatos: (41) 3248-4585 / (41) 3248-3717 · comercial@pinheirinhoservicos.com.br\n    </div>\n  </div>\n</body>\n</html>\n';
}

function baixarArquivo(){
  const a = document.createElement("a");
  a.href = arqUrl;
  a.download = arqNome;
  document.body.appendChild(a);
  a.click();
  a.remove();
}

/* ===== Processo principal ===== */
async function main(){
  /* Guarda o ID antes do login (o redirect do Microsoft remove a query string) */
  const qs = new URLSearchParams(location.search);
  const qsId = qs.get("id") || qs.get("number") || (qs.get("ids") || "").split(",")[0];
  if (qsId) sessionStorage.setItem("idPendente", qsId);
  const rawId = (qsId || sessionStorage.getItem("idPendente") || "").trim();

  if (!/^\d+$/.test(rawId)){
    falhar("Nenhum checklist foi informado. Abra este link com o número do checklist (ex.: ?id=123).", false);
    return;
  }
  const id = rawId;
  $("mId").textContent = id;

  setStatus("Verificando sua sessão...");
  const token = await getToken();
  if (!token){ setStatus("Redirecionando para o login Microsoft..."); return; }

  const acc = msalApp.getAllAccounts()[0];
  if (acc) $("user").textContent = acc.username;
  setDetail(0, "Sessão ativa");
  setRing(0.05);

  const base = CONFIG.site + "/_api/web/lists(guid'" + CONFIG.listId + "')/items(" + id + ")";

  /* 1) Lê o item (todas as colunas) e a lista de anexos */
  setStep(1);
  setStatus("Lendo o checklist Nº " + id + "...");
  setDetail(1, "Consultando a lista no SharePoint");
  let item;
  try { item = await sp(base, token, false); }
  catch (e) {
    if (e.codigo === 404){ falhar("Checklist Nº " + id + " não encontrado.", false); return; }
    throw e;
  }
  setRing(0.15);
  const anexos = await sp(base + "/AttachmentFiles?$select=FileName,ServerRelativeUrl", token, false);
  const imagens = (anexos.value || []).filter(a => /\.(jpe?g|png|gif|webp|bmp)$/i.test(a.FileName));
  $("mFotos").textContent = imagens.length;
  const pend = PERGUNTAS.filter(p => p.invertido ? item[p.campo] === true : item[p.campo] !== true).length;
  $("mPend").textContent = pend;
  setDetail(1, "27 itens lidos · " + imagens.length + " foto(s)");
  setRing(0.2);

  /* 2) Baixa as fotos (3 por vez, mantendo a ordem) */
  setStep(2);
  const fotos = new Array(imagens.length);
  let feitos = 0;
  setStatus(imagens.length ? "Baixando fotos: 0 de " + imagens.length : "Sem fotos neste checklist.");
  setDetail(2, imagens.length ? "" : "Nenhuma foto anexada");
  let prox = 0;
  async function worker(){
    while (prox < imagens.length){
      const i = prox++;
      const f = imagens[i];
      const url = CONFIG.site + "/_api/web/GetFileByServerRelativeUrl('" +
                  encodeURI(f.ServerRelativeUrl.replace(/'/g, "''")) + "')/$value";
      const blob = await sp(url, token, true);
      fotos[i] = await fotoParaDataUrl(blob);
      feitos++;
      setStatus("Baixando fotos: " + feitos + " de " + imagens.length);
      setDetail(2, feitos + " de " + imagens.length + " fotos");
      setRing(0.2 + 0.6 * (feitos / imagens.length));
    }
  }
  await Promise.all([worker(), worker(), worker()]);

  /* 3) Gera e baixa o arquivo único */
  setStep(3);
  setRing(0.85);
  setStatus("Gerando o arquivo...");
  setDetail(3, "Montando o relatório");
  const html = montarRelatorio(item, fotos);
  const out = new Blob([html], { type: "text/html;charset=utf-8" });
  arqNome = "CHECK-LIST - ID " + id + " - " + fmtData(new Date(), "arquivo") + ".html";
  arqUrl = URL.createObjectURL(out);
  baixarArquivo();
  sessionStorage.removeItem("idPendente");

  items.forEach(li => { li.className = "done"; });
  setDetail(3, arqNome);
  setRing(1);
  $("ring").classList.add("ok");
  $("titulo").textContent = "Download concluído";
  setStatus("Checklist Nº " + id + " salvo em " + arqNome + ".\nVocê já pode fechar esta aba.");
  mostrarAcao("Baixar novamente", baixarArquivo);
  const bAbrir = $("btnAbrir");
  bAbrir.style.display = "";
  bAbrir.onclick = () => window.open(arqUrl, "_blank");
}

main().catch(e => { console.error(e); falhar(e.message); });
</script>
