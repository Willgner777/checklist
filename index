  *{box-sizing:border-box}
  html,body{height:100%}
  body{
    margin:0; background:var(--bg); color:var(--text);
    font-family:"IBM Plex Sans","Segoe UI",Arial,sans-serif; font-size:15px; line-height:1.5;
    display:flex; align-items:center; justify-content:center; padding:24px;
    -webkit-font-smoothing:antialiased;
  }
  .shell{
    display:grid; grid-template-columns:300px 1fr; width:min(940px,100%); min-height:540px;
    background:var(--surface); border:1px solid var(--line); border-radius:18px; overflow:hidden;
    box-shadow:0 30px 70px -30px rgba(14,26,43,.45);
  }

  /* Painel lateral */
  .side{background:var(--ink); color:#fff; padding:32px 28px; display:flex; flex-direction:column; justify-content:space-between; gap:32px}
  .brand{display:flex; align-items:center; gap:12px}
  .brand-mark{width:42px; height:42px; border-radius:11px; background:rgba(255,255,255,.07); border:1px solid rgba(255,255,255,.14); display:grid; place-items:center; flex:none}
  .brand-mark svg{width:22px; height:22px; stroke:#fff}
  .brand-name{font-weight:600; font-size:15px; line-height:1.25}
  .brand-sub{font-size:13px; color:var(--ink-soft)}
  dl{margin:0; display:grid; gap:20px}
  dl div{border-top:1px solid rgba(255,255,255,.12); padding-top:14px}
  dt{font-size:13px; color:var(--ink-soft)}
  dd{margin:2px 0 0; font-size:30px; font-weight:500; font-variant-numeric:tabular-nums; letter-spacing:-.01em}
  .who{font-size:13px; color:var(--ink-soft); border-top:1px solid rgba(255,255,255,.12); padding-top:14px}
  .who strong{display:block; color:#fff; font-weight:500; word-break:break-all}

  /* Conteúdo */
  .main{padding:40px 44px; display:flex; flex-direction:column; gap:28px}
  h1{margin:0; font-size:24px; font-weight:600; letter-spacing:-.015em}
  .lead{margin:6px 0 0; color:var(--muted); max-width:52ch}

  .progress{display:flex; align-items:center; gap:28px}
  .ring{position:relative; width:128px; height:128px; flex:none}
  .ring svg{width:100%; height:100%; transform:rotate(-90deg)}
  .ring .track{stroke:var(--track)}
  .ring .bar{stroke:var(--brand); transition:stroke-dashoffset .35s ease, stroke .2s}
  .ring .pct{position:absolute; inset:0; display:grid; place-items:center; font-size:28px; font-weight:600; font-variant-numeric:tabular-nums; letter-spacing:-.02em}
  .ring.ok .bar{stroke:var(--ok)}
  .ring.erro .bar{stroke:var(--err)}
  #status{font-size:15px; font-weight:500; white-space:pre-line}
  #status.erro{color:var(--err)}

  ol{list-style:none; margin:0; padding:0}
  ol li{position:relative; display:grid; grid-template-columns:24px 1fr; gap:14px; padding-bottom:20px}
  ol li:last-child{padding-bottom:0}
  ol li::before{content:""; position:absolute; left:11px; top:26px; bottom:2px; width:2px; background:var(--track)}
  ol li:last-child::before{display:none}
  ol li.done::before{background:var(--brand)}
  .mk{width:24px; height:24px; border-radius:50%; border:2px solid var(--track); background:var(--surface); display:grid; place-items:center; color:#fff; position:relative; z-index:1}
  .mk svg{width:12px; height:12px; stroke:currentColor; opacity:0}
  li.done .mk{background:var(--brand); border-color:var(--brand)}
  li.done .mk svg{opacity:1}
  li.active .mk{border-color:var(--brand); border-top-color:transparent; animation:spin .8s linear infinite}
  li.erro .mk{background:var(--err); border-color:var(--err)}
  li.erro .mk svg{opacity:1}
  li.erro .mk .ic-ok{display:none}
  li:not(.erro) .mk .ic-x{display:none}
  .tt{font-size:14px; font-weight:500}
  li.pending .tt{color:var(--muted); font-weight:400}
  .det{font-size:13px; color:var(--muted); min-height:19px}
  @keyframes spin{to{transform:rotate(360deg)}}

  .actions{margin-top:auto; display:none; gap:12px; flex-wrap:wrap}
  .actions.show{display:flex}
  button{
    font:inherit; font-weight:500; border-radius:10px; padding:11px 20px; cursor:pointer;
    background:var(--brand); color:#fff; border:1px solid var(--brand);
  }
  button.ghost{background:transparent; color:var(--text); border-color:var(--line)}
  button:hover{filter:brightness(1.08)}
  button:focus-visible{outline:3px solid color-mix(in srgb, var(--brand) 45%, transparent); outline-offset:2px}

  @media (max-width:780px){
    body{padding:12px; align-items:flex-start}
    .shell{grid-template-columns:1fr}
    .side{padding:24px; gap:20px}
    dl{grid-template-columns:repeat(3,1fr); gap:12px}
    dl div{padding-top:10px}
    dd{font-size:24px}
    .main{padding:28px 24px}
    .progress{flex-direction:column; align-items:flex-start; gap:16px}
  }
  @media (prefers-reduced-motion: reduce){
    li.active .mk{animation:none}
    .ring .bar{transition:none}
  }
</style>
</head>
