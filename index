/* Logo (PNG em base64) e CSS do relatório, copiados do fluxo */
const LOGO_B64 = "";
const CSS_RELATORIO = "\n  :root {\n    --page-bg:#f1f5f9; --ink:#0f172a; --muted:#64748b; --line:#e2e8f0; --soft:#f8fafc;\n    --ok:#15803d; --ok-bg:#dcfce7; --bad:#b91c1c; --bad-bg:#fee2e2; --radius:14px;\n    font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif;\n  }\n  *{box-sizing:border-box}\n  html,body{margin:0;padding:0;background:var(--page-bg);color:var(--ink);-webkit-font-smoothing:antialiased}\n  .toolbar{max-width:920px;margin:20px auto 0;padding:0 8px;text-align:right}\n  .toolbar button{font:600 13px inherit;font-family:inherit;border:1px solid var(--line);background:#fff;color:var(--ink);padding:9px 16px;border-radius:10px;cursor:pointer}\n  .toolbar button:hover{background:var(--soft)}\n  .wrap{max-width:920px;margin:16px auto 48px;background:#fff;border-radius:var(--radius);border:1px solid rgba(15,23,42,.08);overflow:hidden;box-shadow:0 4px 18px rgba(15,23,42,.06)}\n  .header{width:100%;border-collapse:collapse}\n  .header td{padding:30px 40px;vertical-align:middle}\n  .header img{display:block;max-width:230px;height:auto}\n  .title{text-align:right}\n  .title h1{margin:0;font-size:24px;letter-spacing:2px;font-weight:900;line-height:1}\n  .numero{display:inline-block;margin-top:8px;font-size:13px;font-weight:700;background:#f1f5f9;border:1px solid var(--line);padding:5px 14px;border-radius:6px}\n  .accent{height:4px;background:#000}\n  .container{padding:32px 40px}\n  .card{border:1px solid var(--line);border-radius:var(--radius);padding:24px;margin-bottom:22px;break-inside:avoid;page-break-inside:avoid}\n  .card.flow{break-inside:auto;page-break-inside:auto}\n  .section-title{font-size:13px;font-weight:800;text-transform:uppercase;letter-spacing:1px;margin:0 0 18px;display:flex;align-items:center;gap:10px}\n  .section-title:before{content:\"\";width:3px;height:14px;background:#000;border-radius:2px}\n  .meta{width:100%;border-collapse:separate;border-spacing:10px 10px;margin:-10px}\n  .meta td{border:1px solid var(--line);border-radius:8px;padding:11px 14px;vertical-align:top;width:25%}\n  .label{display:block;color:var(--muted);font-weight:600;font-size:11px;text-transform:uppercase;letter-spacing:.5px;margin-bottom:4px}\n  .value{font-size:14px;font-weight:500}\n  .tablet{margin-top:16px;padding:14px 16px;border:1px solid var(--line);border-left:4px solid var(--ink);border-radius:8px}\n  .banner{border-radius:12px;padding:16px 18px;margin-bottom:18px;font-size:14px;line-height:1.5}\n  .banner strong{display:block;font-size:15px;margin-bottom:2px}\n  .banner ul{margin:8px 0 0;padding-left:20px}\n  .banner li strong{display:inline;font-size:inherit;margin:0}\n  .banner.ok{background:var(--ok-bg);color:var(--ok)}\n  .banner.bad{background:var(--bad-bg);color:var(--bad)}\n  .checklist{width:100%;border-collapse:collapse;font-size:14px}\n  .checklist th{background:var(--soft);color:var(--muted);font-weight:700;text-transform:uppercase;font-size:11px;letter-spacing:.5px;padding:11px 14px;text-align:left;border-bottom:2px solid var(--line)}\n  .checklist td{padding:11px 14px;border-bottom:1px solid #f1f5f9;vertical-align:middle}\n  .checklist tbody tr:nth-child(even){background:var(--soft)}\n  .checklist tr{break-inside:avoid;page-break-inside:avoid}\n  .checklist td.num{width:44px;color:var(--muted);font-weight:700}\n  .checklist td.st{width:110px}\n  .checklist tr.is-bad td{background:#fff7f7}\n  .badge{display:inline-block;min-width:64px;text-align:center;padding:3px 10px;border-radius:999px;font-size:12px;font-weight:700}\n  .badge.ok{background:var(--ok-bg);color:var(--ok)}\n  .badge.bad{background:var(--bad-bg);color:var(--bad)}\n  .photos{display:flex;flex-wrap:wrap;gap:14px}\n  .photo-thumb{width:190px;height:140px;border:1px solid var(--line);border-radius:8px;overflow:hidden;background:#fff}\n  .photo-thumb img{width:100%;height:100%;object-fit:cover;display:block}\n  .empty{margin:0;color:var(--muted);font-size:14px}\n  .footer{padding:26px 40px;font-size:12px;color:var(--muted);line-height:1.6;border-top:1px solid var(--line);text-align:center}\n  .footer strong{color:var(--ink)}\n  @page{size:A4;margin:10mm}\n  @media print{\n    html,body{background:#fff;-webkit-print-color-adjust:exact;print-color-adjust:exact}\n    .toolbar{display:none}\n    .wrap{margin:0;border:0;border-radius:0;box-shadow:none}\n    .header td{padding:20px 28px}\n    .container{padding:20px 28px}\n    .card{padding:18px;margin-bottom:16px}\n    .checklist td{padding:7px 14px}\n    .footer{padding:16px 28px}\n  }\n  @media (max-width:720px){\n    .header td{display:block;text-align:center;padding:22px}\n    .title{text-align:center}\n    .header img{margin:0 auto}\n    .container{padding:20px}\n    .meta td{display:block;width:auto}\n    .meta{border-spacing:0;margin:0}\n    .meta td{margin-bottom:10px}\n  }\n";
